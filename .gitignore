# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.eggs/
dist/
build/

# ── Jupyter ────────────────────────────────────────────────────────────────────
.ipynb_checkpoints/

# ── Virtual environments ───────────────────────────────────────────────────────
.conda/
env/
venv/
.venv/

# ── OS junk ───────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Logs & temp ───────────────────────────────────────────────────────────────
*.log
*.tmp
temp/

# ── Inversion OUTPUT (large, reproducible — do not commit) ────────────────────
inversion-code/MT_Python_code/results/
inversion-code/MT_Python_code/logs/

# ── Binary / large data formats ───────────────────────────────────────────────
*.npz
*.npy
*.mat
*.nc
*.hdf5
*.h5

# ── GIS / shapefile sidecar files (keep .shp/.dbf if you need them) ──────────
*.shx
*.prj
*.cpg
*.qpj

# ── Images (generated outputs — commit only key figures explicitly if needed) ──
*.tif
*.tiff

# ── Third-party model packages (large, not your code) ─────────────────────────
Jiff_ModEM_AP3DMT/
SA2022ModelsAndData/
temp-results

# ── Secrets / environment ─────────────────────────────────────────────────────
.env
*.pem
*.key
